{
   "compilerOptions": {
      "lib": [
         "es2023"
      ],
      "target": "es2022",
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "outDir": "./build",
      "types": ["node"],
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "strictPropertyInitialization": false,
      "sourceMap": true
   }
